# .env.example — DSL量化交易系统环境变量清单
# 复制为 .env 并填入你自己的值。切勿提交 .env 到仓库。
#
# 数据源
# 麦蕊智数 Licence (必填, 系统主要A股数据源: https://mairui.club)
MAIRUI_LICENCE=

# 飞书通知 (可选, 用于日报/告警推送)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_TOKEN=
FEISHU_WEBHOOK_URL=

# 模型/LLM (可选)
OPENROUTER_API_KEY=

# 邮件 (可选)
SMTP_PASSWORD=
